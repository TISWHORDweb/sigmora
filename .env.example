# Database (required)
MONGODB_URI=mongodb://localhost:27017/sigmora

# JWT (required)
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# App URL (payment redirects, password reset links)
FRONTEND_URL=http://localhost:3000

# Optional: override API base (default is same-origin /api)
# NEXT_PUBLIC_API_URL=/api

# Payments (Flutterwave)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your-test-secret-key-here

# Extra CORS origins (comma-separated) if needed
# ALLOWED_ORIGINS=

# Vercel cron secret
# CRON_SECRET=

NODE_ENV=development
